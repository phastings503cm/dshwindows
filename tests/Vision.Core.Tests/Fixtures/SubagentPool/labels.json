  },
  {
   "name": "still clashing after the long form",
   "routes": [
    {
     "name": "Spark",
     "model": "a b"
    },
    {
     "name": "Spark",
     "model": "a-b"
    }
   ],
   "expect": [
    "spark-a-b",
    "spark-a-b-2"
   ]
  },
  {
   "name": "long names are capped at 32",
   "routes": [
    {
     "name": "My Very Long DGX Spark Server Name In The Lab",
     "model": "m"
    }
   ],
   "expect": [
    "my-very-long-dgx-spark-server-na"
   ]
  },
  {
   "name": "different spellings, one slug",
   "routes": [
    {
     "name": "Spark 2",
     "model": "m"
    },
    {
     "name": "spark-2",
     "model": "m"
    }
   ],
   "expect": [
    "spark-2-m",
    "spark-2-m-2"
   ]
  },
  {
   "name": "Settings order decides",
   "routes": [
    {
     "name": "Bedrock",
     "model": "a"
    },
    {
     "name": "Spark",
     "model": "b"
    },
    {
     "name": "Bedrock",
     "model": "c"
    }
   ],
   "expect": [
    "bedrock-a",
    "spark",
    "bedrock-c"
   ]
  }

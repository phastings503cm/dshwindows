<Project Sdk="Microsoft.NET.Sdk">

  <!-- App-level tests: the task queue runner, /goal, background agents and the vault, driven through
       AgentHost against a fake model server. WPF (the Dispatcher), so they run on Windows only. -->
  <PropertyGroup>
    <!-- Matches the app's (it references the Windows 10 SDK projection for OCR). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Vision.App.Tests</RootNamespace>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vision.App\Vision.App.csproj" />
    <ProjectReference Include="..\..\src\Vision.Core\Vision.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Claude Code chats replay the real CLI's captures through the same scripted process the core tests use. -->
    <None Include="..\Vision.Core.Tests\Fixtures\ClaudeCode\**" LinkBase="Fixtures\ClaudeCode" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Vision.Core.Tests\TestSupport\ScriptedClaudeProcess.cs" Link="TestSupport\ScriptedClaudeProcess.cs" />
  </ItemGroup>

</Project>

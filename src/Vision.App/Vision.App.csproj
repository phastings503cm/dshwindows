<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows app. It IS the harness: it runs the agent loop in-process
       and talks straight to an OpenAI-compatible model server. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK projection, for Windows.Media.Ocr (text in attached pictures and scanned PDFs). The app still
         runs on any Windows 10/11: SupportedOSPlatformVersion keeps the floor where it was, and OCR is used only where
         Windows has it. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>Vision</AssemblyName>
    <RootNamespace>Vision.App</RootNamespace>
    <ApplicationIcon>..\..\assets\vision.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF's Fluent theme (ThemeMode) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Faster cold start; the release pipeline publishes self-contained. -->
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app tests drive panels through a few internal hooks. -->
    <InternalsVisibleTo Include="Vision.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vision.Core\Vision.Core.csproj" />
    <ProjectReference Include="..\Vision.Windows\Vision.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\logo-256.png" Link="Assets\logo-256.png" />
    <Resource Include="..\..\assets\vision.ico" Link="Assets\vision.ico" />
    <!-- The DGX Spark guide's pictures (light and dark); make_art.py draws them from SVG. -->
    <Resource Include="Assets\Guide\*.png" />
  </ItemGroup>

</Project>

<Window x:Class="Dsh.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dsh.App.Views"
        xmlns:infra="clr-namespace:Dsh.App.Infrastructure"
        Title="DSH" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        Icon="pack://application:,,,/Assets/dsh.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar: menus, mode switch, project, model, permissions, stop. -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorAltBrush}">
            <DockPanel Margin="6,4,8,4" LastChildFill="True">
                <Menu x:Name="MainMenu" DockPanel.Dock="Left" VerticalAlignment="Center" Background="Transparent">
                    <MenuItem Header="_File">
                        <MenuItem Header="_New Chat" InputGestureText="Ctrl+N" Click="NewChat_Click" />
                        <MenuItem Header="_Open Folder…" InputGestureText="Ctrl+O" Click="OpenFolder_Click" />
                        <MenuItem x:Name="RecentMenu" Header="Open _Recent" SubmenuOpened="RecentMenu_Opened">
                            <MenuItem Header="(none)" IsEnabled="False" />
                        </MenuItem>
                        <MenuItem Header="_Close Folder" Click="CloseFolder_Click" IsEnabled="{Binding Project, Converter={StaticResource NotNull}}" />
                        <Separator />
                        <MenuItem Header="New _Terminal" InputGestureText="Ctrl+Shift+`" Click="NewTerminal_Click" IsEnabled="{Binding Project, Converter={StaticResource NotNull}}" />
                        <Separator />
                        <MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="Save_Click" />
                        <MenuItem Header="Save _All" InputGestureText="Ctrl+Shift+S" Click="SaveAll_Click" />
                        <MenuItem Header="Close _Editor" InputGestureText="Ctrl+W" Click="CloseEditor_Click" />
                        <Separator />
                        <MenuItem Header="Se_ttings…" InputGestureText="Ctrl+," Click="Settings_Click" />
                        <Separator />
                        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
                    </MenuItem>
                    <MenuItem Header="_View">
                        <MenuItem Header="_Chat" InputGestureText="Ctrl+1" Click="ChatMode_Click" />
                        <MenuItem Header="C_ode" InputGestureText="Ctrl+2" Click="CodeMode_Click" />
                        <Separator />
                        <MenuItem Header="Toggle _Sidebar" InputGestureText="Ctrl+Shift+E" Click="ToggleSidebar_Click" />
                        <MenuItem Header="Toggle _File Tree" InputGestureText="Ctrl+B" Click="ToggleTree_Click" />
                        <MenuItem Header="Toggle _Terminal" InputGestureText="Ctrl+`" Click="ToggleTerminal_Click" />
                        <MenuItem Header="Toggle C_hat Panel" InputGestureText="Ctrl+Shift+C" Click="ToggleChatPanel_Click" />
                        <Separator />
                        <MenuItem Header="Go to _File…" InputGestureText="Ctrl+P" Click="GoToFile_Click" />
                        <MenuItem Header="Focus Chat _Input" InputGestureText="Ctrl+L" Click="FocusComposer_Click" />
                    </MenuItem>
                    <MenuItem Header="_Session">
                        <MenuItem Header="_Stop Turn" InputGestureText="Ctrl+." Click="Stop_Click" />
                        <MenuItem Header="Stop _All Agents" InputGestureText="Ctrl+Shift+." Click="StopAll_Click" />
                        <Separator />
                        <MenuItem Header="_Memory &amp; Skills…" InputGestureText="Ctrl+Shift+M" Click="Memory_Click" />
                        <MenuItem Header="Manage S_kills…" Click="Skills_Click" />
                        <MenuItem Header="_Generate a Skill…" Click="GenerateSkill_Click" />
                        <MenuItem Header="_Import Skills…" Click="ImportSkills_Click" />
                        <Separator />
                        <MenuItem Header="_Reload Project Context" Click="ReloadContext_Click" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem Header="Run Setup _Wizard…" Click="Wizard_Click" />
                        <MenuItem Header="_Keyboard Shortcuts" InputGestureText="F1" Click="Shortcuts_Click" />
                        <Separator />
                        <MenuItem Header="Open _Data Folder" Click="DataFolder_Click" />
                        <MenuItem Header="Check for _Updates" Click="CheckUpdates_Click" />
                        <MenuItem Header="_Releases Page" Click="Releases_Click" />
                        <Separator />
                        <MenuItem Header="_About DSH" Click="About_Click" />
                    </MenuItem>
                </Menu>

                <!-- Chat / Code -->
                <Border DockPanel.Dock="Left" Style="{StaticResource SegmentHost}" Margin="10,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ChatModeButton" Style="{StaticResource Segment}" GroupName="Mode" Click="ChatMode_Click"
                                     ToolTip="Chat (Ctrl+1)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="{x:Static infra:Icons.Chat}" Margin="0,0,6,0" />
                                <TextBlock Text="Chat" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="CodeModeButton" Style="{StaticResource Segment}" GroupName="Mode" Click="CodeMode_Click"
                                     ToolTip="Code (Ctrl+2)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="{x:Static infra:Icons.Code}" Margin="0,0,6,0" />
                                <TextBlock Text="Code" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Right side -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ModelButton" Style="{StaticResource SubtleButton}" Margin="2,0" Click="ModelButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="{x:Static infra:Icons.Robot}" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ModelLabel" Text="No model" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="{x:Static infra:Icons.ChevronDown}" Margin="6,1,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PresetButton" Style="{StaticResource SubtleButton}" Margin="2,0" Click="PresetButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PresetGlyph" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock x:Name="PresetLabel" />
                            <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="{x:Static infra:Icons.ChevronDown}" Margin="6,1,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopButton" Margin="6,0,0,0" Padding="10,4" Click="Stop_Click" Visibility="Collapsed"
                            ToolTip="Stop the agent (Ctrl+.)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="{x:Static infra:Icons.Stop}" Margin="0,0,6,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                            <TextBlock x:Name="StopLabel" Text="Stop" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Settings}" Margin="4,0,0,0"
                            ToolTip="Settings (Ctrl+,)" Click="Settings_Click" />
                </StackPanel>

                <!-- Project (centre) -->
                <Button x:Name="ProjectButton" Style="{StaticResource SubtleButton}" HorizontalAlignment="Center" Click="ProjectButton_Click"
                        MaxWidth="360">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="{x:Static infra:Icons.Folder}" Margin="0,0,7,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="ProjectLabel" Text="No project" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="BranchLabel" Margin="8,0,0,0" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Glyph}" FontSize="9" Text="{x:Static infra:Icons.ChevronDown}" Margin="8,1,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="200" MaxWidth="440" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:SidebarView x:Name="Sidebar" Grid.Column="0" />
            <GridSplitter x:Name="SidebarSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}" DragCompleted="SidebarSplitter_DragCompleted" />
            <ContentControl x:Name="Detail" Grid.Column="2" Focusable="False" />
        </Grid>

        <!-- Banners float over the content. -->
        <StackPanel Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" MaxWidth="660" Margin="12">
            <Border x:Name="BannerCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="14,10"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCautionBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{x:Static infra:Icons.Warning}" Margin="0,0,10,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Close}" FontSize="10"
                            Click="DismissBanner_Click" ToolTip="Dismiss" Margin="8,0,0,0" />
                    <Button x:Name="BannerSetupButton" DockPanel.Dock="Right" Content="Set Up…" Margin="8,0,0,0" Padding="10,3"
                            Click="Wizard_Click" Visibility="Collapsed" />
                    <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" MaxHeight="60" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <Border x:Name="UpdateCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="14,10" Margin="0,8,0,0"
                    Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.25" />
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{x:Static infra:Icons.Download}" Margin="0,0,10,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Close}" FontSize="10"
                            Click="DismissUpdate_Click" ToolTip="Dismiss" Margin="8,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="Download" Style="{DynamicResource AccentButtonStyle}" Margin="8,0,0,0" Padding="10,3"
                            Click="DownloadUpdate_Click" />
                    <TextBlock x:Name="UpdateText" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>

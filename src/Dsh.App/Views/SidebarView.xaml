<UserControl x:Class="Dsh.App.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Dsh.App.Infrastructure"
             xmlns:model="clr-namespace:Dsh.App.Model"
             Background="{DynamicResource LayerFillColorDefaultBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Anything running, reachable without opening its chat. -->
        <Border x:Name="RunningBar" Grid.Row="0" Visibility="Collapsed" Cursor="Hand" Padding="12,7"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" MouseLeftButtonUp="RunningBar_Click">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Padding="6,2" Click="StopAll_Click"
                        ToolTip="Stop every running agent (Ctrl+Shift+.)">
                    <TextBlock Text="Stop All" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </Button>
                <infra:Spinner Width="12" Height="12" Margin="0,0,8,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="RunningText" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- Project -->
        <StackPanel Grid.Row="1">
            <TextBlock Style="{StaticResource SectionHeader}" Text="PROJECT" />
            <Border x:Name="ProjectCard" Margin="8,0,8,2" Padding="8,6" CornerRadius="5" Visibility="Collapsed"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" ToolTip="{Binding Project}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Reveal in Explorer" Click="RevealProject_Click" />
                        <MenuItem Header="Copy Path" Click="CopyProjectPath_Click" />
                        <MenuItem Header="Open Terminal Here" Click="ProjectTerminal_Click" />
                        <Separator />
                        <MenuItem Header="Close Folder" Click="CloseProject_Click" />
                    </ContextMenu>
                </Border.ContextMenu>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{x:Static infra:Icons.FolderOpen}" Margin="0,0,8,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel>
                        <TextBlock x:Name="ProjectName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ProjectBranch" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="6,0"
                    Click="OpenFolder_Click" ToolTip="Open a project folder (Ctrl+O)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="{x:Static infra:Icons.NewFolder}" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Open Folder…" />
                </StackPanel>
            </Button>
            <Expander x:Name="RecentExpander" Header="Recent" Margin="8,2,8,0" Padding="0" Visibility="Collapsed" FontSize="12"
                      Style="{DynamicResource DefaultExpanderStyle}">
                <ItemsControl x:Name="RecentList" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="6,4" ToolTip="{Binding}" Click="Recent_Click" Tag="{Binding}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Remove from Recent" Click="ForgetRecent_Click" Tag="{Binding}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="{x:Static infra:Icons.Recent}" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="{Binding Converter={x:Static infra:FileNameConverter.Instance}}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>

        <!-- Chats header with search -->
        <DockPanel Grid.Row="2" Margin="0,6,8,2">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Add}" FontSize="12"
                    MinWidth="26" MinHeight="26" Padding="5" Click="NewChat_Click" ToolTip="New chat (Ctrl+N)" VerticalAlignment="Bottom" />
            <TextBlock Style="{StaticResource SectionHeader}" Text="CHATS" />
        </DockPanel>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBox x:Name="SearchBox" Margin="8,0,8,4" Padding="8,4" FontSize="12" TextChanged="Search_Changed"
                     Visibility="Collapsed" ToolTip="Filter chats by title" infra:Placeholder.Text="Search chats" />
            <ListBox x:Name="ChatList" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0,0,0,8"
                     ItemContainerStyle="{StaticResource NavListItem}" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionChanged="ChatList_SelectionChanged" KeyDown="ChatList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:SessionVM}">
                        <Grid Background="Transparent" ToolTip="{Binding Title}">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Rename…" InputGestureText="F2" Click="Rename_Click" />
                                    <MenuItem Header="Stop Agent" Click="StopSession_Click"
                                              Visibility="{Binding Running, Converter={StaticResource BoolToVisibility}}" />
                                    <MenuItem Header="Reveal Project in Explorer" Click="RevealSessionProject_Click"
                                              Visibility="{Binding WorkspacePath, Converter={StaticResource NullToVisibility}}" />
                                    <MenuItem Header="Copy Transcript" Click="CopyTranscript_Click" />
                                    <Separator />
                                    <MenuItem Header="Delete…" InputGestureText="Del" Click="Delete_Click" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <infra:Spinner Width="11" Height="11" VerticalAlignment="Top" Margin="0,3,0,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                           Visibility="{Binding Running, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="{x:Static infra:Icons.Message}" VerticalAlignment="Top"
                                       Margin="0,3,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding Running, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding ProjectName}" FontSize="11" Style="{StaticResource TertiaryText}"
                                               MaxWidth="120" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding ProjectName, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Text=" · " FontSize="11" Style="{StaticResource TertiaryText}"
                                               Visibility="{Binding ProjectName, Converter={StaticResource NullToVisibility}}" />
                                    <TextBlock Text="{Binding UpdatedLabel}" FontSize="11" Style="{StaticResource TertiaryText}" />
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Stop}" FontSize="11"
                                    MinWidth="24" MinHeight="24" Padding="4" VerticalAlignment="Center" Click="StopSession_Click"
                                    Foreground="{DynamicResource SystemFillColorCriticalBrush}" ToolTip="Stop this agent"
                                    Visibility="{Binding Running, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyChats" Grid.Row="1" Margin="18,6" Text="No chats yet" Style="{StaticResource TertiaryText}"
                       FontSize="12" Visibility="Collapsed" />
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="6,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Settings}"
                        Click="Settings_Click" ToolTip="Settings (Ctrl+,)" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Education}"
                        Click="Skills_Click" ToolTip="Skills" />
                <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Left" Click="NewChat_Click" ToolTip="New chat (Ctrl+N)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="{x:Static infra:Icons.Edit}" Margin="0,0,8,0" />
                        <TextBlock Text="New Chat" />
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

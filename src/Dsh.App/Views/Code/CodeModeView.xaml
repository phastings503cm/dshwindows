<UserControl x:Class="Dsh.App.Views.Code.CodeModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Dsh.App.Infrastructure"
             xmlns:code="clr-namespace:Dsh.App.Model.Code"
             xmlns:views="clr-namespace:Dsh.App.Views.Code"
             Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <UserControl.Resources>
        <!-- Editor tabs and terminal tabs: flat, with an accent bar under the active one. -->
        <Style x:Key="TabItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,0,4,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}"
                                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeColumn" Width="250" MinWidth="160" MaxWidth="520" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="300" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="ChatColumn" Width="420" MinWidth="320" MaxWidth="760" />
        </Grid.ColumnDefinitions>

        <!-- File tree -->
        <Grid x:Name="TreePane" Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="8,6,4,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Page}" FontSize="12" MinWidth="26" MinHeight="26"
                            Padding="5" Click="NewFile_Click" ToolTip="New file" />
                    <Button Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.NewFolder}" FontSize="12" MinWidth="26" MinHeight="26"
                            Padding="5" Click="NewFolder_Click" ToolTip="New folder" />
                    <Button Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Refresh}" FontSize="12" MinWidth="26" MinHeight="26"
                            Padding="5" Click="Refresh_Click" ToolTip="Refresh" />
                </StackPanel>
                <TextBox x:Name="FilterBox" Padding="6,3" FontSize="12" infra:Placeholder.Text="Go to file (Ctrl+P)"
                         TextChanged="Filter_Changed" PreviewKeyDown="Filter_PreviewKeyDown" />
            </DockPanel>
            <TreeView x:Name="Tree" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0,0,0,8"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyDown="Tree_KeyDown">
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type code:FileNode}" ItemsSource="{Binding Children}">
                        <DockPanel Background="Transparent" ToolTip="{Binding Path}" MouseLeftButtonUp="TreeItem_Click"
                                   ContextMenuOpening="TreeItem_ContextMenuOpening">
                            <DockPanel.ContextMenu>
                                <ContextMenu />
                            </DockPanel.ContextMenu>
                            <Ellipse DockPanel.Dock="Right" Width="7" Height="7" Margin="6,0,4,0" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                     Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock x:Name="Glyph" Style="{StaticResource Glyph}" FontSize="12" Text="{Binding Glyph}" Margin="0,0,7,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                        <HierarchicalDataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Tint}" Value="accent">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tint}" Value="green">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tint}" Value="orange">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tint}" Value="red">
                                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tint}" Value="purple">
                                <Setter TargetName="Glyph" Property="Foreground" Value="#9A6BD8" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tint}" Value="yellow">
                                <Setter TargetName="Glyph" Property="Foreground" Value="#C9A227" />
                            </DataTrigger>
                        </HierarchicalDataTemplate.Triggers>
                    </HierarchicalDataTemplate>
                </TreeView.Resources>
            </TreeView>
            <ListBox x:Name="FilterResults" Grid.Row="1" BorderThickness="0" Background="Transparent" Visibility="Collapsed"
                     ItemContainerStyle="{StaticResource NavListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseLeftButtonUp="FilterResult_Click" KeyDown="FilterResults_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type views:FileHit}">
                        <StackPanel ToolTip="{Binding Path}">
                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Folder}" Style="{StaticResource TertiaryText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoMatches" Grid.Row="1" Text="No matches" Style="{StaticResource TertiaryText}" Margin="16,8" Visibility="Collapsed" />
            <StackPanel x:Name="NoProject" Grid.Row="1" Margin="16,24" Visibility="Collapsed">
                <TextBlock Text="No folder open" FontWeight="SemiBold" />
                <TextBlock Text="Open a folder to browse and edit its files." Style="{StaticResource BodyWrap}" Margin="0,4,0,12" />
                <Button Content="Open Folder…" HorizontalAlignment="Left" Padding="12,4" Style="{DynamicResource AccentButtonStyle}"
                        Click="OpenFolder_Click" />
            </StackPanel>
        </Grid>
        <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}" />

        <!-- Editor and terminal -->
        <Grid Grid.Column="2" x:Name="CenterPane">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="TerminalRow" Height="240" MinHeight="0" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <!-- Tab strip with layout toggles -->
                <Border DockPanel.Dock="Top" Height="34" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorAltBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0">
                            <ToggleButton x:Name="TreeToggle" Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Pane}" FontSize="12"
                                          MinWidth="28" MinHeight="28" Padding="6" Click="TreeToggle_Click" ToolTip="Show or hide the file tree (Ctrl+B)" />
                            <ToggleButton x:Name="TerminalToggle" Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Terminal}" FontSize="12"
                                          MinWidth="28" MinHeight="28" Padding="6" Click="TerminalToggle_Click" ToolTip="Toggle the terminal (Ctrl+`)" />
                            <ToggleButton x:Name="ChatToggle" Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Chat}" FontSize="12"
                                          MinWidth="28" MinHeight="28" Padding="6" Click="ChatToggle_Click" ToolTip="Show or hide the agent (Ctrl+Shift+C)" />
                        </StackPanel>
                        <ListBox x:Name="Tabs" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource TabItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="Tabs_SelectionChanged" PreviewMouseDown="Tabs_PreviewMouseDown">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type code:CodeDocument}">
                                    <StackPanel Orientation="Horizontal" Height="32" ToolTip="{Binding Path}">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Close" InputGestureText="Ctrl+W" Click="CloseTab_Click" />
                                                <MenuItem Header="Close Others" Click="CloseOthers_Click" />
                                                <Separator />
                                                <MenuItem Header="Copy Path" Click="CopyTabPath_Click" />
                                                <MenuItem Header="Reveal in Explorer" Click="RevealTab_Click" />
                                                <MenuItem Header="Reveal in File Tree" Click="RevealTabInTree_Click" />
                                                <MenuItem Header="Mention in Chat" Click="MentionTab_Click" />
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                                        <Grid Width="22" Height="22" Margin="6,0,0,0">
                                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                                     Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                                            <Button x:Name="Close" Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Close}" FontSize="8"
                                                    MinWidth="20" MinHeight="20" Padding="3" Click="CloseTab_Click" ToolTip="Close (Ctrl+W)" Opacity="0" />
                                        </Grid>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Close" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Close" Property="Opacity" Value="1" />
                                            <Setter TargetName="Dot" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Close" Property="Opacity" Value="1" />
                                            <Setter TargetName="Dot" Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Close" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- Errors from file operations -->
                <Border x:Name="ErrorBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="12,6"
                        Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Close}" FontSize="9"
                                MinWidth="22" MinHeight="22" Padding="4" Click="DismissError_Click" />
                        <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="{x:Static infra:Icons.Error}" Margin="0,0,8,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="ErrorText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- The agent (or anything else) rewrote a file that has unsaved edits. -->
                <Border x:Name="ConflictBar" DockPanel.Dock="Top" Visibility="Collapsed" Padding="12,6"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Reload from Disk" Padding="10,3" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}"
                                Click="Reload_Click" />
                        <Button DockPanel.Dock="Right" Content="Keep Mine" Padding="10,3" Click="KeepMine_Click" />
                        <TextBlock Style="{StaticResource Glyph}" FontSize="12" Text="{x:Static infra:Icons.Warning}" Margin="0,0,8,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock x:Name="ConflictText" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <!-- Status bar -->
                <Border DockPanel.Dock="Bottom" x:Name="StatusBar" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorAltBrush}" Padding="12,3" Visibility="Collapsed">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="SaveLink" Style="{StaticResource SubtleButton}" Padding="6,0" Click="Save_Click" Visibility="Collapsed"
                                    ToolTip="Save (Ctrl+S)">
                                <TextBlock Text="Save" FontSize="11.5" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Button>
                            <TextBlock x:Name="CaretText" Style="{StaticResource MetaText}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="IndentText" Style="{StaticResource MetaText}" Margin="14,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="EncodingText" Style="{StaticResource MetaText}" Margin="14,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="EolText" Style="{StaticResource MetaText}" Margin="14,0,0,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="LanguageText" Style="{StaticResource MetaText}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="PathText" Style="{StaticResource MetaText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Grid>
                    <ContentControl x:Name="EditorHost" Focusable="False" />
                    <StackPanel x:Name="NoFile" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="34" Text="{x:Static infra:Icons.Page}" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="No file open" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock x:Name="NoFileHint" Style="{StaticResource BodyWrap}" TextAlignment="Center" />
                        <TextBlock Style="{StaticResource MetaText}" HorizontalAlignment="Center" Margin="0,12,0,0"
                                   Text="Ctrl+P go to file · Ctrl+` terminal · Ctrl+L chat" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <GridSplitter x:Name="TerminalSplitter" Grid.Row="1" Style="{StaticResource PaneSplitterRow}" />

            <!-- Terminal panel -->
            <DockPanel x:Name="TerminalPane" Grid.Row="2">
                <Border DockPanel.Dock="Top" Height="32" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Background="{DynamicResource LayerFillColorAltBrush}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0">
                            <Button Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Add}" FontSize="11" MinWidth="26" MinHeight="26"
                                    Padding="5" Click="NewTerminal_Click" ToolTip="New terminal (Ctrl+Shift+`)" />
                            <Button Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Erase}" FontSize="11" MinWidth="26" MinHeight="26"
                                    Padding="5" Click="ClearTerminal_Click" ToolTip="Clear" />
                            <Button Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Delete}" FontSize="11" MinWidth="26" MinHeight="26"
                                    Padding="5" Click="KillTerminal_Click" ToolTip="Close this terminal" />
                            <Button Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.ChevronDown}" FontSize="10" MinWidth="26" MinHeight="26"
                                    Padding="5" Click="HideTerminal_Click" ToolTip="Hide the panel (Ctrl+`)" />
                        </StackPanel>
                        <ListBox x:Name="TerminalTabs" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource TabItemStyle}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 SelectionChanged="TerminalTabs_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type code:TerminalSession}">
                                    <StackPanel Orientation="Horizontal" Height="30" ToolTip="{Binding Cwd}">
                                        <TextBlock Style="{StaticResource Glyph}" FontSize="11" Text="{x:Static infra:Icons.Terminal}" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                                        <Button Style="{StaticResource IconButton}" Content="{x:Static infra:Icons.Close}" FontSize="8" Margin="4,0,0,0"
                                                MinWidth="20" MinHeight="20" Padding="3" Click="CloseTerminal_Click" ToolTip="Close" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <views:TerminalControl x:Name="Terminal" />
                    <ScrollBar x:Name="TerminalScroll" Grid.Column="1" Orientation="Vertical" SmallChange="1" LargeChange="10"
                               Scroll="TerminalScroll_Scroll" />
                </Grid>
            </DockPanel>
        </Grid>

        <GridSplitter x:Name="ChatSplitter" Grid.Column="3" Style="{StaticResource PaneSplitter}" />

        <!-- The agent, where the side panel would be -->
        <Border Grid.Column="4" x:Name="ChatPane" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <ContentControl x:Name="ChatHost" Focusable="False" />
        </Border>
    </Grid>
</UserControl>

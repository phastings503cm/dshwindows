<Project>
  <!-- Shared by every project in the repository. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Major.minor is set here; CI stamps the patch number (commits on the
         default branch) so every release gets a unique, increasing version. -->
    <!-- 0.9 is the first version under the name Vision. Versions only ever go up: installed copies
         offer a release only when its version is higher than their own. -->
    <VersionPrefix>0.9.0</VersionPrefix>
    <Product>Vision for Windows</Product>
    <Company>Vision</Company>
    <Copyright>Copyright © Vision contributors</Copyright>
    <RepositoryUrl>https://github.com/phastings503cm/vision-windows</RepositoryUrl>
    <!-- Lets the WPF app compile on Linux/macOS build machines too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
